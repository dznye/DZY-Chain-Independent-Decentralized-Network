# One validator of the Dznye chain. Copy to validator.env, fill in, keep private: it holds the validator's secret.
# Start: node node/server.mjs --env validator.env --data ./chain-data --host 0.0.0.0 --port 8787

# the chain, from its genesis file (in this repository)
GENESIS=./launch/dznye-mainnet.genesis.json

# this validator's key, from `node cli.mjs key new validator.json`. On this one machine only.
VALIDATOR_ADDRESS=
VALIDATOR_SECRET=

# where other validators and nodes reach this one: a public https address
PUBLIC_URL=https://your-node.example.com

# the nodes to copy from and talk to, comma-separated
PEERS=https://api.dznye.com

# optional
# SNAPSHOT_FROM=https://api.dznye.com   an EMPTY node starts from a snapshot instead of block 1...
# TRUST_HASH=                           ...when that snapshot's block has exactly this hash
# SNAPSHOT_EVERY=1000                   keep a snapshot every this many blocks
